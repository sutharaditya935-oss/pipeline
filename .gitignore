# Python environment (recreate with: python3 -m venv .venv && .venv/bin/pip install -r requirements.txt)
.venv/
__pycache__/
*.pyc

# Intermediate traces: regenerate from CAPE reports with extract.py
traces/
traces_*/

# Logs
*.log

# Never commit raw corpus material
*.zip
*.7z
report.json
**/analyses/

# Sensitivity variants: regenerate with sensitivity.py (only the summary is kept)
results_sensitivity/*/

# Annotation sheets and the heuristic key stay private until annotation is finished
annotation/

# Raw signature output (170 MB); the gzipped copy is committed
results/signatures.jsonl
results/sig_run.log
